{
  "name": "plate-engine",
  "version": "0.1.0",
  "description": "Procedural engravings and the dither that prints them: generators, ordered, blue-noise and error-diffusion dither, CPU and WebGL renderers, PNG and BMP export for e-paper.",
  "license": "MIT",
  "author": "Saeed Peyman",
  "homepage": "https://speyyman.github.io/plate-engine/docs/",
  "bugs": {
    "url": "https://github.com/speyyman/plate-engine/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "BENCHMARKS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "keywords": [
    "dither",
    "bayer",
    "blue-noise",
    "floyd-steinberg",
    "atkinson",
    "procedural",
    "generative-art",
    "e-ink",
    "bmp",
    "png",
    "webgl"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/speyyman/plate-engine.git",
    "directory": "packages/plate-engine"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "docs": "typedoc",
    "bench": "npm run build && node scripts/bench.mjs",
    "blue-noise": "node scripts/gen-blue-noise.mjs",
    "prepublishOnly": "npm run build && npm test",
    "smoke:pack": "node scripts/pack-smoke.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  }
}
